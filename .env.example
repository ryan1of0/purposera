# PURPOSERA uses Gemini to map a mission into capabilities, roles and next steps.
# Get a key at https://aistudio.google.com/apikey and copy this file to .env.local
#
# Without a key the app still works: it falls back to a keyword-driven map.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash-lite (fast enough for a live demo).
GEMINI_MODEL=
# Optional. Used only if the primary model is overloaded. Defaults to gemini-3.1-flash-lite.
GEMINI_FALLBACK_MODEL=
